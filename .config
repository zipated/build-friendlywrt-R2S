# ============================================================
# FriendlyWrt R2S / R2S Plus (RK3328) 配置
#
# 编译时该文件会追加到厂商 configs/rockchip/* 之后，
# 然后执行 `make defconfig` 展开成完整的 .config。
# 构建结束后，最终展开的 .config 会作为 config.txt 上传到 Release。
# ============================================================

# CONFIG_TARGET_rockchip=y
# CONFIG_TARGET_rockchip_armv8=y
# CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r2s=y
#
# # 常用 LuCI 应用（厂商配置已包含 ttyd/upnp/nlbwmon/sqm 等，这里只追加差异项）
# CONFIG_PACKAGE_luci-app-wol=y
#
# # 命令行工具
# CONFIG_PACKAGE_htop=y
# CONFIG_PACKAGE_nano=y
